#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# Argus Recon — service control.
#
# Scanning lives in the dashboard, not in this shell. This command only starts,
# stops and inspects the argus-recon service that serves it.
#
#   ./argus              is it live? (status)
#   ./argus open         open the dashboard in a browser
#   ./argus start|stop|restart
#   ./argus logs         follow the service log
#   ./argus upgrade      pull the latest + restart  (./install.sh --upgrade)
# ---------------------------------------------------------------------------
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SERVICE="argus-recon"
PORT="${ARGUS_WEB_PORT:-7666}"
HOST="${ARGUS_WEB_HOST:-127.0.0.1}"
URL="http://$HOST:$PORT"

say() { printf '\033[1;36m[argus]\033[0m %s\n' "$*"; }
err() { printf '\033[1;31m[argus]\033[0m %s\n' "$*" >&2; }

case "${1:-status}" in
  status|--status|-s)
    exec "$here/install.sh" --status
    ;;

  start)
    systemctl --user start "$SERVICE.service" 2>/dev/null \
      || { err "the service is not installed — run ./install.sh"; exit 1; }
    exec "$here/install.sh" --status
    ;;

  stop)
    systemctl --user stop "$SERVICE.service" 2>/dev/null || true
    say "stopped. Start it again with: ./argus start"
    ;;

  restart)
    exec "$here/install.sh" --restart
    ;;

  logs|log)
    exec journalctl --user -u "$SERVICE" -f
    ;;

  upgrade)
    exec "$here/install.sh" --upgrade
    ;;

  open)
    if command -v xdg-open >/dev/null; then exec xdg-open "$URL" >/dev/null 2>&1; fi
    say "open $URL in your browser"
    ;;

  help|--help|-h)
    sed -n '3,13p' "$0" | sed 's/^# \{0,1\}//'
    ;;

  *)
    # Almost certainly someone typing the old `./argus example.com`.
    echo
    err "Scanning from the terminal has been removed."
    echo "        Argus runs as a service and every scan starts from the dashboard:"
    echo
    echo "            $URL"
    echo
    if [[ "${1:-}" == *.* ]]; then
      echo "        Enter '$1' in the target field there and press Run scan."
      echo
    fi
    echo "        ./argus            is it live?"
    echo "        ./argus open       open the dashboard"
    echo "        ./argus --help     everything this command does"
    echo
    exit 2
    ;;
esac
