.venv/
.impeccable/
__pycache__/
*.pyc
scans/*.json
scans/.jobs/
# dashboard access log (who connected · JSON Lines, one file per day)
scans/.access/
# runtime cache / job-queue store and the embedded graph DB (derived from scans)
scans/.argus.db*
scans/.kuzu*
!scans/.gitkeep
.env
# account store: password hashes, per-account allowances and the token signing
# secret. Machine-local by definition — committing it would publish the secret
# that mints valid sessions for this dashboard.
key.json
key.json.tmp*
